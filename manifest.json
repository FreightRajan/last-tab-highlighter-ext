{
  "manifest_version": 3,
  "name": "Last Tab Highlighter",
  "version": "2.1.0",
  "description": "Marks the tab you just left with a ◀ HERE prefix in the title so you can find your way back.",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Last Tab Highlighter"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
